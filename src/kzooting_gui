def get_resource_path(relative_path):
    """Get absolute path to resource, works for dev and PyInstaller"""
    if getattr(sys, 'frozen', False):
        base_path = sys._MEIPASS
    else:
        base_path = os.path.dirname(os.path.abspath(sys.argv[0]))
    return os.path.join(base_path, relative_path)

# Conversion functions between ADC and voltage
def adc_to_voltage(adc_value):
    """Convert ADC value to voltage (16-bit ADC, 3.3V reference)"""
    return (adc_value / 65535) * 3.3

def voltage_to_adc(voltage):
    """Convert voltage to ADC value (16-bit ADC, 3.3V reference)"""
    return int((voltage / 3.3) * 65535)

class State(QObject):
    """
    Implementation of the Observer Pattern to control application
    state in a centralized manner. Callbacks are always executed
    on the main thread of the application using Qt Signals.
    """

    __update_signal = pyqtSignal(str, object)

    def __init__(self):
        super(QObject, self).__init__()
        self.__dict__["listeners"] = collections.defaultdict(list)
        self.__update_signal.connect(self.__execute_callbacks)

    def attach_listener(self, property_name, callback):
        self.listeners[property_name].append(callback)

    def setter(self, property_name):
        return lambda value: self.__setattr__(property_name, value)

    def __execute_callbacks(self, property_name, value):
        for callback in self.listeners.get(property_name, []):
            callback(value)

    def __setattr__(self, property_name, value):
        self.__dict__[property_name] = value
        self.__update_signal.emit(property_name, value)


class ColorPickerWidget(QWidget):
    """Custom color picker with S/L box and hue bar"""
    
    colorChanged = pyqtSignal(str)
    
    def __init__(self, initial_color="#000000"):
        super().__init__()
        self.setFixedSize(320, 280)
        
        # Parse initial color
        color = QColor(initial_color)
        self.hue = color.hueF() if color.hueF() >= 0 else 0
        self.sat = color.saturationF()
        self.light = color.lightnessF()
        
        self.sl_box_rect = QRect(10, 10, 240, 240)
        self.hue_bar_rect = QRect(260, 10, 30, 240)
        
        self.dragging_sl = False
        self.dragging_hue = False
        
    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.Antialiasing)
        
        # Draw S/L box
        for y in range(self.sl_box_rect.height()):
            for x in range(self.sl_box_rect.width()):
                s = x / self.sl_box_rect.width()
                l = 1 - (y / self.sl_box_rect.height())
                color = QColor.fromHslF(self.hue, s, l)
                painter.setPen(color)
                painter.drawPoint(
                    self.sl_box_rect.x() + x,
                    self.sl_box_rect.y() + y
                )
        
        # Draw border around S/L box
        painter.setPen(QPen(QColor("#ff4d49"), 2))
        painter.drawRect(self.sl_box_rect)
        
        # Draw current position marker on S/L box
        marker_x = int(self.sl_box_rect.x() + self.sat * self.sl_box_rect.width())
        marker_y = int(self.sl_box_rect.y() + (1 - self.light) * self.sl_box_rect.height())
        painter.setPen(QPen(Qt.white, 2))
        painter.drawEllipse(marker_x - 5, marker_y - 5, 10, 10)
        painter.setPen(QPen(Qt.black, 1))
        painter.drawEllipse(marker_x - 4, marker_y - 4, 8, 8)
        
        # Draw hue bar
        for y in range(self.hue_bar_rect.height()):
            h = y / self.hue_bar_rect.height()
            color = QColor.fromHslF(h, 1.0, 0.5)
            painter.setPen(color)
            painter.drawLine(
                self.hue_bar_rect.x(),
                self.hue_bar_rect.y() + y,
                self.hue_bar_rect.right(),
                self.hue_bar_rect.y() + y
            )
        
        # Draw border around hue bar
        painter.setPen(QPen(QColor("#ff4d49"), 2))
        painter.drawRect(self.hue_bar_rect)
        
        # Draw current hue marker
        hue_y = int(self.hue_bar_rect.y() + self.hue * self.hue_bar_rect.height())
        painter.setPen(QPen(Qt.white, 2))
        painter.drawLine(
            self.hue_bar_rect.x() - 2,
            hue_y,
            self.hue_bar_rect.right() + 2,
            hue_y
        )
        
    def mousePressEvent(self, event):
        if self.sl_box_rect.contains(event.pos()):
            self.dragging_sl = True
            self.update_sl_from_mouse(event.pos())
        elif self.hue_bar_rect.contains(event.pos()):
            self.dragging_hue = True
            self.update_hue_from_mouse(event.pos())
    
    def mouseMoveEvent(self, event):
        if self.dragging_sl:
            self.update_sl_from_mouse(event.pos())
        elif self.dragging_hue:
            self.update_hue_from_mouse(event.pos())
    
    def mouseReleaseEvent(self, event):
        self.dragging_sl = False
        self.dragging_hue = False
    
    def update_sl_from_mouse(self, pos):
        x = max(0, min(pos.x() - self.sl_box_rect.x(), self.sl_box_rect.width()))
        y = max(0, min(pos.y() - self.sl_box_rect.y(), self.sl_box_rect.height()))
        
        self.sat = x / self.sl_box_rect.width()
        self.light = 1 - (y / self.sl_box_rect.height())
        
        self.update()
        self.colorChanged.emit(self.get_hex_color())
    
    def update_hue_from_mouse(self, pos):
        y = max(0, min(pos.y() - self.hue_bar_rect.y(), self.hue_bar_rect.height()))
        self.hue = y / self.hue_bar_rect.height()
        
        self.update()
        self.colorChanged.emit(self.get_hex_color())
    
    def get_hex_color(self):
        color = QColor.fromHslF(self.hue, self.sat, self.light)
        return color.name()
    
    def set_hex_color(self, hex_color):
        color = QColor(hex_color)
        if color.isValid():
            self.hue = color.hueF() if color.hueF() >= 0 else 0
            self.sat = color.saturationF()
            self.light = color.lightnessF()
            self.update()


class ColorPickerDialog(QDialog):
    def __init__(self, initial_color="#000000", parent=None):
        super().__init__(parent)
        self.setWindowTitle("Pick Color")
        self.selected_color = initial_color
        
        layout = QVBoxLayout()
        
        # Color picker widget
        self.color_picker = ColorPickerWidget(initial_color)
        
        # Hex input with preview
        hex_layout = QHBoxLayout()
        hex_label = QLabel("Hex:")
        self.hex_input = QLineEdit(initial_color)
        self.hex_input.setMaxLength(7)
        
        # Color preview button
        self.preview_button = QPushButton()
        self.preview_button.setFixedSize(80, 30)
        self.preview_button.setStyleSheet(
            f"background-color: {initial_color}; border: 0px;"
        )
        self.preview_button.setEnabled(False)
        
        hex_layout.addWidget(hex_label)
        hex_layout.addWidget(self.hex_input)
        hex_layout.addWidget(self.preview_button)
        
        # Buttons
        buttons = QHBoxLayout()
        cancel_btn = QPushButton("Cancel")
        ok_btn = QPushButton("OK")
        cancel_btn.clicked.connect(self.reject)
        ok_btn.clicked.connect(self.accept)
        buttons.addStretch()
        buttons.addWidget(cancel_btn)
        buttons.addWidget(ok_btn)
        
        layout.addWidget(self.color_picker)
        layout.addLayout(hex_layout)
        layout.addLayout(buttons)
        self.setLayout(layout)
        
        # Connect signals
        self.color_picker.colorChanged.connect(self.on_picker_color_changed)
        self.hex_input.textEdited.connect(self.on_hex_input_changed)
        
        self.setFixedSize(400, 370)
    
    def on_picker_color_changed(self, hex_color):
        self.hex_input.setText(hex_color)
        self.preview_button.setStyleSheet(
            f"background-color: {hex_color}; border: 0px;"
        )
        self.selected_color = hex_color
    
    def on_hex_input_changed(self, text):
        if len(text) == 7 and text.startswith('#'):
            color = QColor(text)
            if color.isValid():
                self.color_picker.set_hex_color(text)
                self.preview_button.setStyleSheet(
                    f"background-color: {text}; border: 0px;"
                )
                self.selected_color = text


class GeneralInfo(QWidget):
    """
    Top left quadrant of the window
    """

    def __init__(self, state):
        super(GeneralInfo, self).__init__()

        # Set up dropdown menu for ports
        ports_menu = QComboBox()
        ports_menu.textActivated.connect(state.setter("selected_port"))
        self.was_empty = True

        def update_ports(ports):
            ports_menu.clear()
            for port in ports:
                ports_menu.addItem(port)
            if self.was_empty and len(ports):
                ports_menu.setCurrentText(ports[0])
                state.selected_port = ports[0]
                self.was_empty = False
            elif len(ports) == 0:
                self.was_empty = True

        state.attach_listener("available_ports", update_ports)

        # Set up info strings
        info_strings = QLabel()
        info_strings.setText(
            "Internal temperature: 0.00°C\n" "Reports per second: 000 (0.00ms)\n"
        )
        info_strings.setFixedWidth(300)

        state.attach_listener(
            "info",
            lambda info: info_strings.setText(
                f"Internal temperature: {info['temperature']:.1f}°C\n"
                f"Reports per second: {1000/info['report_time']:.0f} ({info['report_time']:.2f}ms)"
            ),
        )

        # Populate grid
        general_info_grid = QGridLayout()
        general_info_grid.addWidget(ports_menu, 0, 0, 1, 2)
        general_info_grid.addWidget(info_strings, 1, 0)
        self.setLayout(general_info_grid)


